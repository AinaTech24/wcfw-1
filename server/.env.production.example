# ============================================================
# WCFW Backend - Production Environment Variables
# Copy these into Hostinger hPanel → Environment Variables
# OR create a .env file on your VPS server
# ============================================================

# MongoDB Atlas Connection String (replace with your actual URI)
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/wcfw_cms?retryWrites=true&w=majority

# Security — CHANGE THIS to a long random string (min 32 characters)
JWT_SECRET=change_this_to_a_very_long_random_secret_string_min_32_chars
JWT_EXPIRE=7d

# Server Port (Hostinger VPS: 5001 | hPanel Node.js: use the assigned port)
PORT=5001

# Node Environment
NODE_ENV=production

# Your Backend's Public URL (used for uploaded image URLs)
# Example: https://api.yourwebsite.com  OR  https://yourwebsite.com:5001
BASE_URL=https://api.yourwebsite.com

# IIFL API (leave as simulation if not using live trading)
IIFL_SIMULATION=true
IIFL_APP_KEY=your_app_key_here
IIFL_SECRET_KEY=your_secret_key_here
IIFL_SOURCE=WEBAPI
IIFL_USER_ID=your_user_id_here
